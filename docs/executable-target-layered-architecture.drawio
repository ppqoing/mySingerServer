        <mxCell id="s-title" value="公用代码库模块图" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1580" height="40" as="geometry"/></mxCell>
