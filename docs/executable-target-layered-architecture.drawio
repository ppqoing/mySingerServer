        <mxCell id="w-domain-session" value="&lt;b&gt;媒体会话与缓存决策&lt;/b&gt;&lt;br&gt;一次打开、部分命中、缺失计算、发布前复核" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="390" width="310" height="110" as="geometry"/></mxCell>
