        <mxCell id="g-entry-root" value="&lt;b&gt;进程组合与生命周期&lt;/b&gt;&lt;br&gt;cmd/gui：依赖装配、启动与关闭" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="170" y="112" width="310" height="70" as="geometry"/></mxCell>
