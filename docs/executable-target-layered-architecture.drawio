        <mxCell id="w-infra-videocore" value="&lt;b&gt;VideoCore C ABI&lt;/b&gt;&lt;br&gt;统一媒体会话、运行时兼容检查" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="170" y="555" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="w-infra-ffmpeg" value="&lt;b&gt;FFmpeg 运行时&lt;/b&gt;&lt;br&gt;视频元数据、抽帧、时长与联系表" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="395" y="555" width="210" height="130" as="geometry"/></mxCell>
