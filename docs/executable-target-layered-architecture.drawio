        <mxCell id="g-entry-http" value="&lt;b&gt;Web / HTTP 入站模块&lt;/b&gt;&lt;br&gt;管理页面、JSON API、静态资源" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="112" width="310" height="70" as="geometry"/></mxCell>
        <mxCell id="g-entry-agent" value="&lt;b&gt;Agent 事件入站模块&lt;/b&gt;&lt;br&gt;TCP + Protobuf 消息与任务结果映射" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1145" y="112" width="335" height="70" as="geometry"/></mxCell>
