        <mxCell id="a-infra-helper" value="&lt;b&gt;Helper TCP 客户端&lt;/b&gt;&lt;br&gt;Protobuf 删除转发、结果汇总与错误映射" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1070" y="555" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="a-infra-control" value="&lt;b&gt;本机 TCP 控制与可观测性&lt;/b&gt;&lt;br&gt;Protobuf 控制服务、stats、pprof" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1295" y="555" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="a-note" value="关键边界：Agent 是 Worker 的唯一生命周期所有者和 TCP 监听方；Worker 携带实例 ID 主动回连注册；删除必须经 Helper；SQLite 是节点扫描期间的事实来源。" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;" vertex="1" parent="1"><mxGeometry x="170" y="720" width="1335" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

