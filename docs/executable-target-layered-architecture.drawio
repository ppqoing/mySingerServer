        <mxCell id="s-contract-group" value="统一接口合同库" style="swimlane;html=1;horizontal=1;startSize=35;rounded=0;fontSize=14;fontStyle=1;fillColor=#e1d5e7;swimlaneFillColor=#f5eff8;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="25" y="210" width="750" height="300" as="geometry"/></mxCell>
        <mxCell id="s-contract-central" value="&lt;b&gt;centralnode.proto&lt;/b&gt;&lt;br&gt;Hello、Scan、Phase2、Delete、Stats、Heartbeat&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;迁移自：internal/proto&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="265" width="335" height="95" as="geometry"/></mxCell>
