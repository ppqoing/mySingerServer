        <mxCell id="h-infra-hard" value="&lt;b&gt;Windows 硬删除模块&lt;/b&gt;&lt;br&gt;文件属性、只读处理与单文件删除" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="620" y="555" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="h-infra-pipe" value="&lt;b&gt;本机 TCP 服务&lt;/b&gt;&lt;br&gt;Protobuf、协议版本、监听地址与连接管理" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="845" y="555" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="h-infra-instance" value="&lt;b&gt;进程实例管理&lt;/b&gt;&lt;br&gt;命名互斥体、MachineID、PID 与路径信息" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1070" y="555" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="h-infra-log" value="&lt;b&gt;配置与运行日志&lt;/b&gt;&lt;br&gt;internal/helper/config、logging、错误映射" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1295" y="555" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="h-note" value="模块边界：Helper 只执行当前任务 ID 的逐项删除，不重放旧任务；删除清单、代表保护、二次确认和中断后的剩余文件重算由 GUI 负责。" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;" vertex="1" parent="1"><mxGeometry x="170" y="720" width="1335" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

