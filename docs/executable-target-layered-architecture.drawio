        <mxCell id="g-border" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1580" height="800" as="geometry"/></mxCell>
        <mxCell id="g-title" value="gui.exe 目标分层架构" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1580" height="40" as="geometry"/></mxCell>
        <mxCell id="g-desc" value="中央控制面：连接多个 Agent，编排扫描、分析和删除，并向浏览器提供唯一生产管理入口；不执行媒体计算或本机删除。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="80" y="58" width="1440" height="34" as="geometry"/></mxCell>

