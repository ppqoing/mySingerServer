        <mxCell id="s-contract-control" value="&lt;b&gt;nodectl.proto&lt;/b&gt;&lt;br&gt;Status、Stop、生命周期与组件进程信息&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;迁移自：internal/nodectl&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="385" width="335" height="95" as="geometry"/></mxCell>
        <mxCell id="s-contract-delete" value="&lt;b&gt;deletion.proto&lt;/b&gt;&lt;br&gt;删除模式、逐项请求、稳定错误与报告&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;迁移自：internal/proto + helper&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="385" width="335" height="95" as="geometry"/></mxCell>

