        <mxCell id="s-type-media" value="&lt;b&gt;media&lt;/b&gt;&lt;br&gt;MediaKind、Phase、FieldsMask、FrameMask&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;当前：worker 常量&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1185" y="265" width="345" height="95" as="geometry"/></mxCell>
        <mxCell id="s-type-features" value="&lt;b&gt;features&lt;/b&gt;&lt;br&gt;PHash Parts、Sobel Hist、Feature Blob 编码&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;当前：internal/features&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="385" width="345" height="95" as="geometry"/></mxCell>
        <mxCell id="s-type-config" value="&lt;b&gt;configuration / ConfigLoader&lt;/b&gt;&lt;br&gt;统一读取接口、默认值合并与校验结果&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;各 EXE 保留自己的配置 Schema&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1185" y="385" width="345" height="95" as="geometry"/></mxCell>

        <mxCell id="s-codec-group" value="通信、指标与测试支持代码库" style="swimlane;html=1;horizontal=1;startSize=35;rounded=0;fontSize=14;fontStyle=1;fillColor=#ffe6cc;swimlaneFillColor=#fff7ef;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="25" y="530" width="1000" height="170" as="geometry"/></mxCell>
        <mxCell id="s-codec-protobuf" value="&lt;b&gt;Protobuf Codec&lt;/b&gt;&lt;br&gt;生成与序列化" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="585" width="170" height="85" as="geometry"/></mxCell>
        <mxCell id="s-codec-frame" value="&lt;b&gt;TCP Frame Codec&lt;/b&gt;&lt;br&gt;帧、超时与错误映射" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="585" width="170" height="85" as="geometry"/></mxCell>
        <mxCell id="s-codec-fingerprint" value="&lt;b&gt;Config Fingerprint&lt;/b&gt;&lt;br&gt;规范 JSON + SHA-256" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="585" width="170" height="85" as="geometry"/></mxCell>
        <mxCell id="s-support-metrics" value="&lt;b&gt;metrics&lt;/b&gt;&lt;br&gt;计数、直方图与快照" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="620" y="585" width="170" height="85" as="geometry"/></mxCell>
        <mxCell id="s-support-testkit" value="&lt;b&gt;testkit（仅开发/测试）&lt;/b&gt;&lt;br&gt;协议回放、故障注入与基准 fixture" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="810" y="585" width="190" height="85" as="geometry"/></mxCell>

        <mxCell id="s-boundary" value="&lt;b&gt;公用代码库边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;只放跨两个及以上 EXE 稳定复用的代码、配置读取接口与通信合同。&lt;br&gt;&lt;br&gt;&lt;b&gt;不放入：&lt;/b&gt;业务用例、SQL/SQLite 仓储、进程管理、媒体算法、HTTP/Wails UI。" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1045" y="530" width="520" height="170" as="geometry"/></mxCell>
        <mxCell id="s-note" value="建议统一入口：internal/shared。建立 contracts、protobuf、transport、configuration、identity、media、features、metrics；testkit 仅供开发与测试。它们都不是业务分层。" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;" vertex="1" parent="1"><mxGeometry x="170" y="725" width="1335" height="50" as="geometry"/></mxCell>
