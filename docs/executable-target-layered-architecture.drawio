        <mxCell id="n-title" value="nodetray.exe 目标分层架构" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1580" height="40" as="geometry"/></mxCell>
        <mxCell id="n-desc" value="本机节点管理应用：向操作员提供配置、状态和组件生命周期控制；不执行媒体计算、删除或中央分析。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="80" y="58" width="1440" height="34" as="geometry"/></mxCell>

