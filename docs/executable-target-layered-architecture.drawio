        <mxCell id="w-infra-cache" value="&lt;b&gt;联系表缓存模块&lt;/b&gt;&lt;br&gt;原子发布、缓存元数据与临时文件回收" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1070" y="555" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="w-infra-tcp" value="&lt;b&gt;Agent TCP 客户端与文件系统&lt;/b&gt;&lt;br&gt;实例 ID 注册、Protobuf、缓存查询、长路径与文件身份" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1295" y="555" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="w-note" value="关键边界：Worker 不访问 SQLite/PostgreSQL，不管理其他 Worker，也不监听业务端口；启动后携带实例 ID 主动回连 Agent 的单一 loopback TCP 端点。目标运行时统一为 VideoCore。" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;" vertex="1" parent="1"><mxGeometry x="170" y="720" width="1335" height="55" as="geometry"/></mxCell>
