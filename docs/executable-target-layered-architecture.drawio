        <mxCell id="n-entry-config" value="&lt;b&gt;配置文件读取模块&lt;/b&gt;&lt;br&gt;独立配置、默认值、校验与磁盘指纹" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="965" y="112" width="250" height="70" as="geometry"/></mxCell>
