// 页面分段标题只承载文字、可选图标和调用方提供的动作槽。

import { Theme } from "../theme.slint";

export component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;

    min-height: root.subtitle == "" ? 36px : 48px;
    background: transparent;
    HorizontalLayout {
        spacing: 10px;
        alignment: center;
        if root.icon.width > 0 && root.icon.height > 0 : Image {
            source: root.icon;
            width: 20px;
            height: 20px;
            image-fit: contain;
            colorize: Theme.nav-icon;
        }
        VerticalLayout {
            spacing: 3px;
            alignment: center;
            Text { text: root.title; color: Theme.text; font-size: 16px; font-weight: 680; }
            if root.subtitle != "" : Text { text: root.subtitle; color: Theme.muted; font-size: 11px; overflow: elide; }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        @children
    }
}
