// 八个固定业务入口的左侧导航，不动态增加未确认页面。

import { Theme } from "../theme.slint";

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback activated();
    height: 44px;
    border-radius: 8px;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.panel-hover : transparent;
    Rectangle {
        visible: root.selected;
        width: 3px;
        height: 24px;
        border-radius: 2px;
        background: Theme.accent;
        x: 0px;
        y: 10px;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        spacing: 12px;
        Text { text: root.icon; color: root.selected ? Theme.accent : Theme.muted; font-size: 17px; width: 24px; }
        Text { text: root.label; color: root.selected ? Theme.text : Theme.muted; font-size: 14px; vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { root.activated(); } }
}

export component Navigation inherits Rectangle {
    in-out property <int> current-page;
    callback navigate(int);
    width: 220px;
    background: Theme.sidebar;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 18px;
        spacing: 6px;
        Rectangle {
            height: 62px;
            background: transparent;
            HorizontalLayout {
                spacing: 10px;
                alignment: center;
                Rectangle {
                    width: 34px; height: 34px; border-radius: 9px; background: Theme.accent;
                    Text { text: "M"; color: white; font-size: 18px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: "Media Dedup"; color: Theme.text; font-size: 16px; font-weight: 700; }
                    Text { text: "Rust V2 · x64"; color: Theme.muted; font-size: 11px; }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        NavItem { icon: "⌂"; label: "总览与节点"; selected: root.current-page == 0; activated => { root.navigate(0); } }
        NavItem { icon: "⌕"; label: "扫描任务"; selected: root.current-page == 1; activated => { root.navigate(1); } }
        NavItem { icon: "≡"; label: "精确重复"; selected: root.current-page == 2; activated => { root.navigate(2); } }
        NavItem { icon: "▧"; label: "相似图片"; selected: root.current-page == 3; activated => { root.navigate(3); } }
        NavItem { icon: "▶"; label: "相似视频"; selected: root.current-page == 4; activated => { root.navigate(4); } }
        NavItem { icon: "⌘"; label: "跨机器"; selected: root.current-page == 5; activated => { root.navigate(5); } }
        NavItem { icon: "✓"; label: "删除复核"; selected: root.current-page == 6; activated => { root.navigate(6); } }
        Rectangle { vertical-stretch: 1; background: transparent; }
        NavItem { icon: "⚙"; label: "设置与诊断"; selected: root.current-page == 7; activated => { root.navigate(7); } }
        Text { text: "TCP + Protobuf · 明文局域网"; color: Theme.muted; font-size: 10px; horizontal-alignment: center; }
    }
}
