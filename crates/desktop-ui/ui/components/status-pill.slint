// 小型矩形状态标签只表达文本和语义色，不承载业务判断。

import { Theme } from "../theme.slint";

export component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> tone: Theme.muted;
    height: 24px;
    min-width: 72px;
    border-radius: 4px;
    background: root.tone.with-alpha(0.13);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.45);
    accessible-role: AccessibleRole.groupbox;
    accessible-label: "状态：" + root.label;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.tone;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-label: "状态文字：" + root.label;
    }
}
