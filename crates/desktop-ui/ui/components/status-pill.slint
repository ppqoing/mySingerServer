// 小型状态胶囊只表达文本和语义色，不承载业务判断。

import { Theme } from "../theme.slint";

export component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> tone: Theme.muted;
    height: 24px;
    min-width: 72px;
    border-radius: 12px;
    background: root.tone.with-alpha(0.13);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.45);

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        alignment: center;
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.tone;
        }
        Text {
            text: root.label;
            color: root.tone;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}
