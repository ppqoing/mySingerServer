// 小型状态胶囊只表达文本和语义色，不承载业务判断。

import { Theme } from "../theme.slint";

export component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> tone: Theme.muted;
    height: 26px;
    min-width: 86px;
    border-radius: 13px;
    background: root.tone.with-alpha(0.13);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.45);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        alignment: center;
        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: root.tone;
        }
        Text {
            text: root.label;
            color: root.tone;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}
