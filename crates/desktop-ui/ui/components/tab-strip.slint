// 轻量页签条以蓝字和 2px 下划线表达选中状态。

import { Theme } from "../theme.slint";

export component TabStrip inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> active-index;
    callback changed(int);

    height: 42px;
    background: transparent;
    HorizontalLayout {
        spacing: 0px;
        for label[index] in root.labels : tab := Rectangle {
            width: 112px;
            background: touch.has-hover ? Theme.panel-hover : transparent;
            accessible-role: AccessibleRole.tab;
            accessible-label: label;
            accessible-item-selected: root.active-index == index;
            accessible-action-default => {
                root.active-index = index;
                root.changed(index);
            }
            Text {
                text: label;
                color: root.active-index == index ? Theme.accent : Theme.muted;
                font-size: 12px;
                font-weight: root.active-index == index ? 650 : 450;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                visible: root.active-index == index;
                height: 2px;
                y: parent.height - self.height;
                background: Theme.accent;
            }
            touch := TouchArea {
                clicked => {
                    root.active-index = index;
                    root.changed(index);
                }
            }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }
}
