// 高密度成员表；在线门禁、分数、复核状态与原有三个动作保持同一行模型。

import { ScrollView } from "std-widgets.slint";
import { Theme, UiMemberRow } from "../theme.slint";
import { EmptyState } from "empty-state.slint";
import { StatusPill } from "status-pill.slint";

// 固定宽度动作避免标准按钮最小宽度挤压 300px 详情列，同时保留真实可访问默认动作。
component MemberAction inherits Rectangle {
    in property <string> label;
    in property <string> accessible-name;
    in property <bool> action-enabled: true;
    callback clicked();
    width: 48px;
    height: 22px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    background: root.action-enabled ? action-touch.has-hover ? Theme.panel-hover : Theme.panel : Theme.panel-hover;
    opacity: root.action-enabled ? 1 : 0.5;
    accessible-role: AccessibleRole.button;
    accessible-label: root.accessible-name;
    accessible-action-default => { if root.action-enabled { root.clicked(); } }
    Text { text: root.label; color: Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
    action-touch := TouchArea { enabled: root.action-enabled; clicked => { root.clicked(); } }
}

export component MemberList inherits Rectangle {
    in property <[UiMemberRow]> members;
    callback preview(string, string);
    callback review(string, string, int);

    background: Theme.panel;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: "成员表";

    VerticalLayout {
        Rectangle {
            height: 34px;
            background: Theme.panel-hover;
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 6px;
                alignment: center;
                Text { text: "代表 / 在线"; width: 74px; color: Theme.muted; font-size: 9px; }
                Text { text: "路径 / 机器"; horizontal-stretch: 1; color: Theme.muted; font-size: 9px; }
                Text { text: "大小 / 元数据"; width: 92px; color: Theme.muted; font-size: 9px; }
                Text { text: "Stage1"; width: 42px; color: Theme.muted; font-size: 9px; horizontal-alignment: center; }
                Text { text: "pHash"; width: 38px; color: Theme.muted; font-size: 9px; horizontal-alignment: center; }
                Text { text: "Stage2"; width: 42px; color: Theme.muted; font-size: 9px; horizontal-alignment: center; }
                Text { text: "复核 / 动作"; width: 164px; color: Theme.muted; font-size: 9px; }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        if root.members.length == 0 : EmptyState {
            vertical-stretch: 1;
            title: "选择重复组后加载成员";
            detail: "成员列表不会自动预取图片或视频预览。";
        }
        if root.members.length > 0 : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                for member in root.members : Rectangle {
                    height: 68px;
                    background: member.representative ? Theme.accent-soft : Theme.panel;
                    border-width: 0px;
                    accessible-role: AccessibleRole.list-item;
                    accessible-label: "成员：" + member.path;
                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        spacing: 6px;
                        alignment: center;
                        StatusPill {
                            width: 74px;
                            label: member.representative ? "代表" : member.online ? "在线" : "离线";
                            tone: member.representative ? Theme.accent : member.online ? Theme.success : Theme.muted;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            alignment: center;
                            Text { text: member.path; color: Theme.text; font-size: 10px; overflow: elide; }
                            Text { text: member.machine-id + " · " + member.md5; color: Theme.muted; font-size: 8px; overflow: elide; }
                        }
                        VerticalLayout {
                            width: 92px;
                            spacing: 2px;
                            alignment: center;
                            Text { text: member.size; color: Theme.text; font-size: 9px; overflow: elide; }
                            Text { text: member.metadata; color: Theme.muted; font-size: 8px; overflow: elide; }
                        }
                        Text { text: member.stage1; width: 42px; color: Theme.muted; font-size: 9px; horizontal-alignment: center; }
                        Text { text: member.phash; width: 38px; color: Theme.muted; font-size: 9px; horizontal-alignment: center; }
                        Text { text: member.stage2; width: 42px; color: Theme.text; font-size: 9px; horizontal-alignment: center; }
                        VerticalLayout {
                            width: 164px;
                            spacing: 3px;
                            StatusPill { label: member.review; tone: member.review-color; }
                            HorizontalLayout {
                                spacing: 3px;
                                MemberAction {
                                    label: "预览";
                                    accessible-name: "预览成员：" + member.path;
                                    action-enabled: member.preview-enabled;
                                    clicked => { root.preview(member.machine-id, member.path); }
                                }
                                MemberAction {
                                    label: "保留";
                                    accessible-name: "保留成员：" + member.path;
                                    clicked => { root.review(member.machine-id, member.path, 1); }
                                }
                                MemberAction {
                                    label: "删除";
                                    accessible-name: "删除成员：" + member.path;
                                    action-enabled: member.delete-enabled;
                                    clicked => { root.review(member.machine-id, member.path, 2); }
                                }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                }
            }
        }
    }
}
