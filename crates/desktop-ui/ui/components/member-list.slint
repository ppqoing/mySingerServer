// 组成员、在线动作门禁、直接分数与持久复核操作。

import { Button } from "std-widgets.slint";
import { Theme, UiMemberRow } from "../theme.slint";
import { StatusPill } from "status-pill.slint";
import { ScorePanel } from "score-panel.slint";

export component MemberList inherits Rectangle {
    in property <[UiMemberRow]> members;
    callback preview(string, string);
    callback review(string, string, int);
    background: transparent;

    VerticalLayout {
        spacing: 8px;
        if root.members.length == 0 : Rectangle {
            height: 130px; background: Theme.panel; border-radius: 9px; border-width: 1px; border-color: Theme.border;
            Text { text: "选择重复组后加载成员"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
        }
        for member in root.members : Rectangle {
            height: 92px; background: Theme.panel; border-radius: 9px; border-width: 1px; border-color: member.representative ? Theme.accent : Theme.border;
            VerticalLayout { padding: 11px; spacing: 7px;
                HorizontalLayout { spacing: 10px; alignment: center;
                    StatusPill { label: member.representative ? "代表" : member.online ? "在线" : "离线"; tone: member.representative ? Theme.accent : member.online ? Theme.success : Theme.muted; }
                    Text { text: member.path; color: Theme.text; font-size: 12px; horizontal-stretch: 1; overflow: elide; }
                    StatusPill { label: member.review; tone: member.review-color; }
                    Button { text: "预览"; enabled: member.preview-enabled; clicked => { root.preview(member.machine-id, member.path); } }
                    Button { text: "保留"; clicked => { root.review(member.machine-id, member.path, 1); } }
                    Button { text: "删除"; enabled: member.delete-enabled; clicked => { root.review(member.machine-id, member.path, 2); } }
                }
                HorizontalLayout { spacing: 12px; alignment: center;
                    Text { text: member.machine-id; color: Theme.muted; font-size: 9px; width: 155px; overflow: elide; }
                    Text { text: member.size + " · " + member.metadata; color: Theme.muted; font-size: 10px; width: 160px; }
                    ScorePanel { stage1: member.stage1; phash: member.phash; stage2: member.stage2; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: member.md5; color: Theme.muted; font-size: 9px; width: 220px; overflow: elide; }
                }
            }
        }
    }
}
