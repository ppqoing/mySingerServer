// 高密度重复组表；只消费中心有限窗口，滚动时请求行范围并替换当前模型。

import { ScrollView } from "std-widgets.slint";
import { Theme, UiGroupRow } from "../theme.slint";
import { EmptyState } from "empty-state.slint";

export component GroupTable inherits Rectangle {
    in property <[UiGroupRow]> groups;
    in property <string> selected-id;
    in property <int> start-index;
    in property <int> total-rows;
    in property <bool> loading;
    in property <bool> stale;
    callback select-group(string);
    callback request-window(int, int);

    background: Theme.panel;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: "重复组表";

    VerticalLayout {
        Rectangle {
            height: Theme.table-header-height;
            background: Theme.panel-hover;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 7px;
                alignment: center;
                Text { text: "类型"; width: 68px; color: Theme.muted; font-size: 10px; }
                Text { text: "组 ID / MD5"; horizontal-stretch: 1; color: Theme.muted; font-size: 10px; }
                Text { text: "代表大小"; width: 70px; color: Theme.muted; font-size: 10px; horizontal-alignment: right; }
                Text { text: "成员"; width: 38px; color: Theme.muted; font-size: 10px; horizontal-alignment: right; }
                Text { text: "可回收空间"; width: 78px; color: Theme.muted; font-size: 10px; horizontal-alignment: right; }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        if root.groups.length == 0 : EmptyState {
            vertical-stretch: 1;
            title: "当前运行没有此类重复组";
            detail: "更换运行 ID 或结果类别后重新加载。";
        }
        if root.loading : Text {
            height: 24px;
            text: "正在读取中心结果窗口…";
            color: Theme.muted;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-label: "结果窗口加载中";
        }
        if root.stale : Text {
            height: 24px;
            text: "文件库已变化，结果只读";
            color: Theme.warning;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-label: "结果窗口已过期";
        }
        if root.groups.length > 0 : result-scroll := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: root.start-index * Theme.table-row-height;
                    background: transparent;
                }
                for group in root.groups : row := Rectangle {
                    height: Theme.table-row-height;
                    background: group.id == root.selected-id ? Theme.accent-soft : row-touch.has-hover ? Theme.panel-hover : Theme.panel;
                    border-width: 0px;
                    accessible-role: AccessibleRole.list-item;
                    accessible-label: "重复组：" + group.id;
                    accessible-item-selected: group.id == root.selected-id;
                    accessible-action-default => { root.select-group(group.id); }
                    // 整行选择层先声明在内容下方；后续行内动作可自然取得更高命中优先级。
                    row-touch := TouchArea { clicked => { root.select-group(group.id); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 7px;
                        alignment: center;
                        Text { text: group.kind; width: 68px; color: Theme.text; font-size: 10px; overflow: elide; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 1px;
                            alignment: center;
                            Text { text: group.id; color: Theme.text; font-size: 10px; font-weight: 620; overflow: elide; }
                            Text { text: group.md5; color: Theme.muted; font-size: 10px; overflow: elide; }
                        }
                        Text { text: group.size; width: 70px; color: Theme.text; font-size: 10px; horizontal-alignment: right; overflow: elide; }
                        Text { text: group.members; width: 38px; color: Theme.text; font-size: 10px; horizontal-alignment: right; }
                        Text { text: group.reclaimable; width: 78px; color: Theme.success; font-size: 10px; horizontal-alignment: right; overflow: elide; }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                }
                Rectangle {
                    height: root.total-rows > root.start-index + root.groups.length
                        ? (root.total-rows - root.start-index - root.groups.length) * Theme.table-row-height
                        : 0px;
                    background: transparent;
                }
            }
            scrolled => {
                // viewport-y 向下滚动时为负值；先换算为全局可见行，再向前保留半窗预读。
                let next-start = max(0, round(-result-scroll.viewport-y / Theme.table-row-height) - root.groups.length / 2);
                root.request-window(next-start, max(1, root.groups.length));
            }
        }
    }
}
