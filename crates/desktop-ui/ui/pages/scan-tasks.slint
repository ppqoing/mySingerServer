// 扫描创建、持久任务进度和计算中筛选门禁页面。

import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox } from "std-widgets.slint";
import { Theme, UiTaskRow } from "../theme.slint";
import { StatusPill } from "../components/status-pill.slint";

export component ScanTasksPage inherits Rectangle {
    in property <[UiTaskRow]> tasks;
    in property <bool> filtering-enabled;
    in property <string> filtering-reason;
    in-out property <string> scan-root: "D:\\Media";
    in-out property <int> selected-node: 0;
    in-out property <int> enumerator-index: 0;
    in-out property <bool> force-recalculate: false;
    in-out property <string> analysis-task-ids;
    in-out property <int> analysis-kind-index: 0;
    callback browse(int, string);
    callback start-scan(int, string, bool, int);
    callback start-analysis(int, string, int);
    callback cancel-task(int, string);
    background: transparent;

    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 18px;
            Text { text: "扫描与任务"; color: Theme.text; font-size: 26px; font-weight: 750; }
            HorizontalLayout { spacing: 16px;
                Rectangle {
                    height: 246px; horizontal-stretch: 2; background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.border;
                    VerticalLayout { padding: 18px; spacing: 12px;
                        Text { text: "新建扫描"; color: Theme.text; font-size: 16px; font-weight: 680; }
                        HorizontalLayout { spacing: 10px;
                            LineEdit { text <=> root.scan-root; placeholder-text: "选择节点上的扫描根目录"; }
                            Button { text: "浏览节点路径"; clicked => { root.browse(root.selected-node, root.scan-root); } }
                        }
                        HorizontalLayout { spacing: 10px;
                            Text { text: "节点索引"; color: Theme.muted; vertical-alignment: center; }
                            SpinBox { value <=> root.selected-node; minimum: 0; maximum: 99; width: 120px; }
                            ComboBox { model: ["Windows Walker", "Everything"]; current-index <=> root.enumerator-index; }
                            CheckBox { text: "强制重新计算"; checked <=> root.force-recalculate; }
                        }
                        HorizontalLayout {
                            Button { text: "开始扫描"; clicked => { root.start-scan(root.selected-node, root.scan-root, root.force-recalculate, root.enumerator-index); } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: "扫描后按机器 ID + 路径 + 大小复用缓存"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle {
                    height: 246px; horizontal-stretch: 1; background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.border;
                    VerticalLayout { padding: 18px; spacing: 10px;
                        Text { text: "筛选门禁"; color: Theme.text; font-size: 16px; font-weight: 680; }
                        StatusPill { label: root.filtering-enabled ? "可以筛选" : "等待计算"; tone: root.filtering-enabled ? Theme.success : Theme.warning; }
                        Text { text: root.filtering-enabled ? "全部节点任务已进入终态。" : root.filtering-reason; color: Theme.muted; wrap: word-wrap; }
                        LineEdit { text <=> root.analysis-task-ids; placeholder-text: "扫描任务 UUID，逗号分隔"; }
                        ComboBox { model: ["精确重复", "相似图片", "相似视频"]; current-index <=> root.analysis-kind-index; }
                        Button {
                            text: "开始本地分析";
                            enabled: root.filtering-enabled && root.analysis-task-ids != "";
                            clicked => { root.start-analysis(root.selected-node, root.analysis-task-ids, root.analysis-kind-index); }
                        }
                    }
                }
            }
            Text { text: "持久任务"; color: Theme.text; font-size: 16px; font-weight: 680; }
            if root.tasks.length == 0 : Rectangle {
                height: 180px; background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.border;
                Text { text: "连接节点后刷新，这里会显示扫描与计算任务。"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
            }
            for task in root.tasks : Rectangle {
                height: 116px; background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.border;
                VerticalLayout { padding: 15px; spacing: 10px;
                    HorizontalLayout { spacing: 12px;
                        Text { text: task.title; color: Theme.text; font-size: 15px; font-weight: 650; width: 210px; }
                        Text { text: task.stage; color: Theme.muted; font-size: 12px; width: 150px; }
                        StatusPill { label: task.status; tone: task.status-color; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button { text: "取消"; enabled: task.status == "排队中" || task.status == "运行中"; clicked => { root.cancel-task(task.node-index, task.id); } }
                    }
                    HorizontalLayout { spacing: 12px;
                        Rectangle { height: 8px; horizontal-stretch: 1; border-radius: 4px; background: Theme.border;
                            Rectangle { height: 8px; width: parent.width * task.progress / 100; border-radius: 4px; background: task.status-color; }
                        }
                        Text { text: task.progress + "%"; color: Theme.text; width: 42px; font-size: 12px; }
                        Text { text: task.counts; color: Theme.muted; width: 250px; font-size: 11px; }
                    }
                }
            }
        }
    }
}
