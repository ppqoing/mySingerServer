// 任务中心只筛选当前已加载行模型，并原样转发现有取消命令。

import { ScrollView } from "std-widgets.slint";
import { Theme, UiTaskRow } from "../theme.slint";
import { ActionButton } from "../components/action-button.slint";
import { DetailPanel } from "../components/detail-panel.slint";
import { EmptyState } from "../components/empty-state.slint";
import { FluentCard } from "../components/fluent-card.slint";
import { ProgressBar } from "../components/progress-bar.slint";
import { StatusPill } from "../components/status-pill.slint";
import { TabStrip } from "../components/tab-strip.slint";

export component TaskCenterPage inherits Rectangle {
    in property <[UiTaskRow]> tasks;
    in-out property <int> task-tab: 0;
    in-out property <int> selected-task-index: 0;
    callback cancel-task(int, string);

    pure function status-matches-tab(status: string) -> bool {
        return (root.task-tab == 0 && (status == "排队中" || status == "运行中"))
            || (root.task-tab == 1 && status == "已完成")
            || (root.task-tab == 2 && status == "失败");
    }

    background: transparent;

    HorizontalLayout {
        padding: 20px;
        spacing: 16px;

        VerticalLayout {
            spacing: 12px;
            horizontal-stretch: 1;

            Text {
                text: "任务中心";
                height: 30px;
                vertical-stretch: 0;
                color: Theme.text;
                font-size: 24px;
                font-weight: 750;
                accessible-role: AccessibleRole.groupbox;
                accessible-label: "任务中心标题";
            }
            TabStrip {
                labels: ["运行中", "已完成", "失败"];
                active-index <=> root.task-tab;
                accessible-role: AccessibleRole.tab-list;
                accessible-label: "任务标签栏";
            }

            // 表头、双行任务和取消动作共用自己的双向滚动视口，300px 详情始终保留。
            FluentCard {
                vertical-stretch: 1;
                accessible-role: AccessibleRole.groupbox;
                accessible-label: "任务主表";
                VerticalLayout {
                    padding: 10px;
                    spacing: 0px;
                    if root.tasks.length == 0 : EmptyState {
                        vertical-stretch: 1;
                        icon: @image-url("../assets/icons/tasks.png");
                        title: "暂无任务";
                        detail: "任务标签只筛选当前已加载模型。";
                        accessible-role: AccessibleRole.groupbox;
                        accessible-label: "任务表空态：" + (root.task-tab == 0 ? "运行中" : root.task-tab == 1 ? "已完成" : "失败");
                    }
                    if root.tasks.length > 0 : task-scroll := ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            min-width: 720px;
                            spacing: 0px;
                            Rectangle {
                                height: 34px;
                                background: Theme.panel-hover;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    alignment: center;
                                    Text { text: "任务 / 节点 / 阶段"; color: Theme.muted; font-size: 10px; horizontal-stretch: 1; }
                                    Text { text: "进度与计数"; color: Theme.muted; font-size: 10px; width: 278px; }
                                    Text { text: "状态"; color: Theme.muted; font-size: 10px; width: 82px; horizontal-alignment: center; }
                                    Text { text: "动作"; color: Theme.muted; font-size: 10px; width: 82px; horizontal-alignment: center; }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.border; }

                            // 行布局的 preferred-height 直接反映当前页签是否存在匹配项。
                            task-rows := VerticalLayout {
                                spacing: 0px;
                                for task[index] in root.tasks : task-row := Rectangle {
                                property <bool> matches-current-tab: root.status-matches-tab(task.status);
                                visible: task-row.matches-current-tab;
                                height: task-row.matches-current-tab ? 58px : 0px;
                                background: root.selected-task-index == index ? Theme.accent-soft : task-touch.has-hover ? Theme.panel-hover : Theme.panel;
                                accessible-role: AccessibleRole.list-item;
                                accessible-label: "任务项：" + task.title + "；节点 " + task.node-index + "；" + task.stage
                                    + "；" + task.progress + "%；" + task.counts + "；" + task.status;
                                accessible-item-selectable: true;
                                accessible-item-selected: root.selected-task-index == index;
                                accessible-action-default => { root.selected-task-index = index; }

                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 5px;
                                    padding-bottom: 5px;
                                    spacing: 3px;
                                    HorizontalLayout {
                                        height: 18px;
                                        spacing: 8px;
                                        Text { text: task.title; color: Theme.text; font-size: 12px; font-weight: 650; horizontal-stretch: 1; overflow: elide; }
                                        Text { text: "节点 " + task.node-index; color: Theme.text; font-size: 11px; width: 64px; overflow: elide; }
                                        Text { text: task.stage; color: Theme.muted; font-size: 11px; width: 108px; overflow: elide; }
                                        Rectangle { width: 442px; background: transparent; }
                                    }
                                    HorizontalLayout {
                                        height: 26px;
                                        spacing: 8px;
                                        ProgressBar {
                                            width: 160px;
                                            value: task.progress;
                                            tone: task.status-color;
                                            accessible-name: "任务进度";
                                        }
                                        Text { text: task.progress + "%"; color: Theme.text; font-size: 11px; width: 34px; vertical-alignment: center; }
                                        Text { text: task.counts; color: Theme.muted; font-size: 10px; width: 208px; overflow: elide; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        StatusPill { label: task.status; tone: task.status-color; width: 82px; }
                                        Rectangle {
                                            width: 82px;
                                            background: transparent;
                                        }
                                    }
                                }
                                // 行命中层排除最右动作列；取消按钮最后声明，二者不会互相吞掉指针。
                                task-touch := TouchArea {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width - 90px;
                                    height: parent.height;
                                    clicked => { root.selected-task-index = index; }
                                }
                                if task.status == "运行中" : ActionButton {
                                    x: parent.width - 90px;
                                    y: 28px;
                                    width: 82px;
                                    height: 26px;
                                    label: "取消";
                                    icon: @image-url("../assets/icons/cancel.png");
                                    accessible-label: "取消任务：" + task.id;
                                    clicked => { root.cancel-task(task.node-index, task.id); }
                                }
                            }
                            }
                            if task-rows.preferred-height == 0px : EmptyState {
                                min-height: max(180px, task-scroll.visible-height - 35px);
                                icon: @image-url("../assets/icons/tasks.png");
                                title: "当前页没有匹配任务";
                                detail: "任务标签只筛选当前已加载模型。";
                                accessible-role: AccessibleRole.groupbox;
                                accessible-label: "任务表空态：" + (root.task-tab == 0 ? "运行中" : root.task-tab == 1 ? "已完成" : "失败");
                            }
                        }
                    }
                }
            }
        }

        // 详情只读取选中 UiTaskRow；速度、ETA、当前文件和日志没有模型字段。
        DetailPanel {
            accessible-label: "任务详情";
            if root.tasks.length > 0
                && root.selected-task-index >= 0
                && root.selected-task-index < root.tasks.length
                && ((root.task-tab == 0 && (root.tasks[root.selected-task-index].status == "排队中" || root.tasks[root.selected-task-index].status == "运行中"))
                    || (root.task-tab == 1 && root.tasks[root.selected-task-index].status == "已完成")
                    || (root.task-tab == 2 && root.tasks[root.selected-task-index].status == "失败"))
            : VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: root.tasks[root.selected-task-index].title; height: 28px; vertical-stretch: 0; color: Theme.text; font-size: 20px; font-weight: 720; }
                Text { text: "任务 ID  " + root.tasks[root.selected-task-index].id; min-height: 20px; vertical-stretch: 0; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                Text { text: "阶段  " + root.tasks[root.selected-task-index].stage; height: 20px; vertical-stretch: 0; color: Theme.text; font-size: 12px; }
                Text { text: "状态  " + root.tasks[root.selected-task-index].status; height: 20px; vertical-stretch: 0; color: Theme.text; font-size: 12px; }
                ProgressBar {
                    width: 220px;
                    value: root.tasks[root.selected-task-index].progress;
                    tone: root.tasks[root.selected-task-index].status-color;
                    accessible-name: "详情进度";
                }
                Text { text: "进度  " + root.tasks[root.selected-task-index].progress + "%"; height: 20px; vertical-stretch: 0; color: Theme.text; font-size: 12px; }
                Text { text: root.tasks[root.selected-task-index].counts; min-height: 20px; vertical-stretch: 0; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                Rectangle { height: 1px; vertical-stretch: 0; background: Theme.border; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                EmptyState {
                    density: 0;
                    icon: @image-url("../assets/icons/info.png");
                    title: "运行明细未接入";
                    detail: "速度、剩余时间、当前文件和事件日志没有现有模型字段。";
                    disabled-feature: true;
                }
            }
            if root.tasks.length == 0
                || root.selected-task-index < 0
                || root.selected-task-index >= root.tasks.length
                || !((root.task-tab == 0 && (root.tasks[root.selected-task-index].status == "排队中" || root.tasks[root.selected-task-index].status == "运行中"))
                    || (root.task-tab == 1 && root.tasks[root.selected-task-index].status == "已完成")
                    || (root.task-tab == 2 && root.tasks[root.selected-task-index].status == "失败"))
            : EmptyState {
                icon: @image-url("../assets/icons/tasks.png");
                title: root.tasks.length == 0 ? "暂无任务" : "请选择当前页签中的任务";
                detail: "任务标签只筛选当前已加载模型。";
            }
        }
    }
}
