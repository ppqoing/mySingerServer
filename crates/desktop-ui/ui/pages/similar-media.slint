// 相似图片与相似视频复用联合分数、按需预览和稳定分页布局。

import { Button, ComboBox, LineEdit, ScrollView, SpinBox } from "std-widgets.slint";
import { Theme, UiGroupRow, UiMemberRow } from "../theme.slint";
import { GroupTable } from "../components/group-table.slint";
import { MemberList } from "../components/member-list.slint";

export component SimilarMediaPage inherits Rectangle {
    in property <int> media-kind;
    in property <[UiGroupRow]> groups;
    in property <[UiMemberRow]> members;
    in property <string> group-next-cursor;
    in property <string> member-next-cursor;
    in property <image> preview-image;
    in property <string> preview-info;
    in-out property <int> source-index;
    in-out property <int> node-index;
    in-out property <string> run-id;
    in-out property <string> selected-group-id;
    callback load-groups(bool, int, string, int, string);
    callback load-members(bool, int, string, string, int, string);
    callback save-review(string, string, int);
    callback preview(string, string);
    background: transparent;

    ScrollView {
        VerticalLayout { padding: 28px; spacing: 16px;
            Text { text: root.media-kind == 1 ? "相似图片" : "相似视频"; color: Theme.text; font-size: 26px; font-weight: 750; }
            Rectangle { height: 84px; background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.border;
                HorizontalLayout { padding: 14px; spacing: 10px; alignment: center;
                    ComboBox { model: ["节点 SQLite", "PostgreSQL 中心"]; current-index <=> root.source-index; width: 170px; }
                    SpinBox { value <=> root.node-index; minimum: 0; maximum: 99; width: 105px; }
                    LineEdit { text <=> root.run-id; placeholder-text: "分析运行 UUID"; horizontal-stretch: 1; }
                    Button { text: "加载结果"; clicked => { root.load-groups(root.source-index == 1, root.node-index, root.run-id, root.media-kind, ""); } }
                }
            }
            HorizontalLayout { spacing: 14px;
                VerticalLayout { horizontal-stretch: 2; spacing: 12px;
                    GroupTable {
                        groups: root.groups; selected-id: root.selected-group-id; has-more: root.group-next-cursor != "";
                        select-group(id) => { root.selected-group-id = id; root.load-members(root.source-index == 1, root.node-index, root.run-id, id, root.media-kind, ""); }
                        load-more => { root.load-groups(root.source-index == 1, root.node-index, root.run-id, root.media-kind, root.group-next-cursor); }
                    }
                }
                Rectangle { width: 360px; height: 300px; background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.border;
                    VerticalLayout { padding: 12px; spacing: 8px;
                        Text { text: root.media-kind == 1 ? "原图按需预览（内存）" : "六帧 3×2 JPG 联系表"; color: Theme.text; font-size: 13px; font-weight: 650; }
                        Image { source: root.preview-image; image-fit: contain; horizontal-stretch: 1; vertical-stretch: 1; }
                        Text { text: root.preview-info; color: Theme.muted; font-size: 10px; overflow: elide; }
                    }
                }
            }
            MemberList {
                members: root.members;
                preview(machine, path) => { root.preview(machine, path); }
                review(machine, path, decision) => { root.save-review(machine, path, decision); }
            }
            if root.member-next-cursor != "" : Button { text: "加载更多成员"; clicked => { root.load-members(root.source-index == 1, root.node-index, root.run-id, root.selected-group-id, root.media-kind, root.member-next-cursor); } }
        }
    }
}
