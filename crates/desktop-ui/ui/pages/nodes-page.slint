// 节点管理页在左侧选择和编辑节点，右侧只解释当前 UiNodeRow 的真实字段。

import { Button, LineEdit, SpinBox, ScrollView } from "std-widgets.slint";
import { Theme, UiNodeRow } from "../theme.slint";
import { DetailPanel } from "../components/detail-panel.slint";
import { EmptyState } from "../components/empty-state.slint";
import { FluentCard } from "../components/fluent-card.slint";
import { StatusPill } from "../components/status-pill.slint";

export component NodesPage inherits Rectangle {
    in property <[UiNodeRow]> nodes;
    in-out property <string> new-node-ip;
    in-out property <int> new-node-port;
    in-out property <int> selected-node-index: 0;
    callback connect-all();
    callback add-node(string, int);
    callback edit-node(int, string, int);
    callback sync-node(int);
    callback remove-node(int);

    background: transparent;

    HorizontalLayout {
        padding: 20px;
        spacing: 16px;

        VerticalLayout {
            spacing: 14px;
            horizontal-stretch: 1;

            HorizontalLayout {
                Text { text: "节点管理"; color: Theme.text; font-size: 24px; font-weight: 750; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button {
                    text: "连接全部";
                    accessible-label: "连接全部节点";
                    clicked => { root.connect-all(); }
                }
            }

            // 节点行既是可访问列表项，也是详情面板的唯一选择入口。
            FluentCard {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "名称"; color: Theme.muted; font-size: 11px; width: 95px; }
                        Text { text: "地址"; color: Theme.muted; font-size: 11px; width: 130px; }
                        Text { text: "状态"; color: Theme.muted; font-size: 11px; width: 70px; }
                        Text { text: "Worker"; color: Theme.muted; font-size: 11px; width: 80px; }
                        Text { text: "任务"; color: Theme.muted; font-size: 11px; horizontal-stretch: 1; }
                        Text { text: "同步位置"; color: Theme.muted; font-size: 11px; width: 80px; }
                    }
                    ScrollView {
                        VerticalLayout {
                            spacing: 4px;
                            for node[index] in root.nodes : row := Rectangle {
                                height: 44px;
                                border-radius: 6px;
                                background: root.selected-node-index == index ? Theme.accent-soft : row-touch.has-hover ? Theme.panel-hover : transparent;
                                accessible-role: AccessibleRole.list-item;
                                accessible-label: "节点项：" + node.name + "；" + node.address + "；" + node.status
                                    + "；Worker " + node.worker-text + "；任务 " + node.task-text + "；同步 " + node.sync-text;
                                accessible-item-selectable: true;
                                accessible-item-selected: root.selected-node-index == index;
                                accessible-action-default => { root.selected-node-index = index; }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 10px;
                                    Text { text: node.name; color: Theme.text; font-size: 12px; width: 95px; overflow: elide; }
                                    Text { text: node.address; color: Theme.muted; font-size: 12px; width: 130px; overflow: elide; }
                                    StatusPill { label: node.status; tone: node.status-color; width: 70px; }
                                    Text { text: node.worker-text; color: Theme.text; font-size: 12px; width: 80px; overflow: elide; }
                                    Text { text: node.task-text; color: Theme.text; font-size: 12px; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: node.sync-text; color: Theme.text; font-size: 12px; width: 80px; overflow: elide; }
                                }
                                row-touch := TouchArea { clicked => { root.selected-node-index = index; } }
                            }
                        }
                    }
                }
            }

            // 添加表单与根属性保持双向绑定，所有动作只转发现有回调。
            FluentCard {
                height: 92px;
                HorizontalLayout {
                    padding: 14px;
                    spacing: 10px;
                    alignment: center;
                    VerticalLayout {
                        width: 85px;
                        alignment: center;
                        Text { text: "新节点"; color: Theme.text; font-size: 14px; font-weight: 650; }
                        Text { text: "IP 与端口"; color: Theme.muted; font-size: 11px; }
                    }
                    LineEdit {
                        text <=> root.new-node-ip;
                        placeholder-text: "192.168.1.20";
                        accessible-label: "新节点 IP";
                    }
                    SpinBox {
                        value <=> root.new-node-port;
                        minimum: 1;
                        maximum: 65535;
                        width: 140px;
                        accessible-label: "新节点端口";
                    }
                    Button {
                        text: "添加节点";
                        accessible-label: "添加节点";
                        clicked => { root.add-node(root.new-node-ip, root.new-node-port); }
                    }
                }
            }
        }

        DetailPanel {
            // 详情只使用已选 UiNodeRow；模型为空或索引越界时不访问列表。
            if root.nodes.length > 0 && root.selected-node-index >= 0 && root.selected-node-index < root.nodes.length : VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text { text: root.nodes[root.selected-node-index].name; color: Theme.text; font-size: 20px; font-weight: 720; }
                Text { text: root.nodes[root.selected-node-index].address; color: Theme.muted; font-size: 12px; }
                StatusPill {
                    label: root.nodes[root.selected-node-index].status;
                    tone: root.nodes[root.selected-node-index].status-color;
                }
                Text { text: "机器 ID  " + root.nodes[root.selected-node-index].machine-id; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                Text { text: "Worker  " + root.nodes[root.selected-node-index].worker-text; color: Theme.text; font-size: 12px; }
                Text { text: "任务  " + root.nodes[root.selected-node-index].task-text; color: Theme.text; font-size: 12px; }
                Text { text: "同步位置  " + root.nodes[root.selected-node-index].sync-text; color: Theme.text; font-size: 12px; }
                if root.nodes[root.selected-node-index].error-text != "" : Text {
                    text: root.nodes[root.selected-node-index].error-text;
                    color: Theme.danger;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Button {
                    text: "编辑";
                    accessible-label: "编辑节点";
                    clicked => {
                        root.edit-node(root.nodes[root.selected-node-index].index, root.new-node-ip, root.new-node-port);
                    }
                }
                Button {
                    text: "同步";
                    accessible-label: "立即同步";
                    clicked => { root.sync-node(root.nodes[root.selected-node-index].index); }
                }
                Button {
                    text: "移除节点";
                    accessible-label: "移除节点";
                    clicked => { root.remove-node(root.nodes[root.selected-node-index].index); }
                }
                EmptyState {
                    vertical-stretch: 1;
                    title: "运行详情暂不可用";
                    detail: "当前节点模型未提供版本、运行时长、服务明细和存储目录";
                    disabled-feature: true;
                }
            }
            if root.nodes.length == 0 || root.selected-node-index < 0 || root.selected-node-index >= root.nodes.length : EmptyState {
                title: "尚未配置节点";
                detail: "请先通过左侧表单添加计算节点";
            }
        }
    }
}
