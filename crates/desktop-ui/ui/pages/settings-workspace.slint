// 设置工作区仅消费 MainWindow 已有属性；未实现能力保持禁用且说明原因。

import { AboutSlint, ComboBox, LineEdit, ScrollView, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "../components/action-button.slint";
import { SectionHeader } from "../components/section-header.slint";

component SettingsMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();
    height: 40px;
    vertical-stretch: 0;
    border-radius: 7px;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.panel-hover : transparent;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    Rectangle { visible: root.selected; width: 3px; x: 0px; y: 7px; height: 26px; border-radius: 2px; background: Theme.accent; }
    Text { x: 16px; width: parent.width - 24px; text: root.label; color: root.selected ? Theme.text : Theme.muted; font-size: 12px; font-weight: root.selected ? 650 : 450; vertical-alignment: center; }
    touch := TouchArea { clicked => { root.activated(); } }
}

component FormLabel inherits Text {
    in property <string> accessible-name;
    color: Theme.muted;
    font-size: 11px;
    vertical-alignment: center;
    accessible-label: root.accessible-name;
}

// 路径和值统一以完整可访问文本暴露，视觉显示对过长值省略。
component ValueRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 40px;
    vertical-stretch: 0;
    border-radius: 6px;
    background: Theme.window;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.label + "：" + root.value;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Text { width: 76px; text: root.label; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
        Text { text: root.value == "" ? "—" : root.value; color: Theme.text; font-size: 12px; overflow: elide; vertical-alignment: center; }
    }
}

component DisabledFeatureRow inherits Rectangle {
    in property <string> action-label;
    in property <string> reason;
    height: Theme.control-height;
    vertical-stretch: 0;
    HorizontalLayout {
        spacing: 12px;
        ActionButton { width: 218px; label: root.action-label; icon: @image-url("../assets/icons/settings.png"); action-enabled: false; }
        Text { text: root.reason; color: Theme.muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
    }
}

export component SettingsWorkspace inherits Rectangle {
    in-out property <int> active-section: 0;
    in-out property <bool> about-open: false;
    in property <string> data-path;
    in property <string> logs-path;
    in property <string> cache-path;
    in property <string> config-path;
    in property <string> postgres-status;
    in property <color> postgres-color;
    in property <string> last-error;
    in-out property <string> postgres-url;
    in-out property <int> reconnect-seconds;
    in-out property <int> delete-mode-index;
    in-out property <string> pdq-quality;
    in-out property <string> aspect-tolerance;
    in-out property <string> pdq-hamming;
    in-out property <string> phash-hamming;
    in-out property <string> phash-parts;
    in-out property <string> sobel-min;
    in-out property <string> video-valid;
    in-out property <string> video-stage1;
    in-out property <string> video-stage2;
    callback save-settings();
    background: transparent;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        SectionHeader {
            height: 48px;
            vertical-stretch: 0;
            title: "设置";
            subtitle: "连接、阈值与本机运行状态";
            icon: @image-url("../assets/icons/settings.png");
            accessible-role: AccessibleRole.groupbox;
            accessible-label: "设置标题";
            ActionButton { label: root.about-open ? "返回设置" : "关于 Slint"; icon: @image-url("../assets/icons/info.png"); clicked => { root.about-open = !root.about-open; } }
            ActionButton { label: "保存设置"; icon: @image-url("../assets/icons/save.png"); tone: 1; clicked => { root.save-settings(); } }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;
            Rectangle {
                width: 190px;
                vertical-stretch: 1;
                background: Theme.panel;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                accessible-role: AccessibleRole.groupbox;
                accessible-label: "设置二级菜单";
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    SettingsMenuItem { label: "常规"; selected: root.active-section == 0; activated => { root.active-section = 0; root.about-open = false; } }
                    SettingsMenuItem { label: "相似度算法"; selected: root.active-section == 1; activated => { root.active-section = 1; root.about-open = false; } }
                    SettingsMenuItem { label: "存储"; selected: root.active-section == 2; activated => { root.active-section = 2; root.about-open = false; } }
                    SettingsMenuItem { label: "节点服务"; selected: root.active-section == 3; activated => { root.active-section = 3; root.about-open = false; } }
                    SettingsMenuItem { label: "扫描与性能"; selected: root.active-section == 4; activated => { root.active-section = 4; root.about-open = false; } }
                    SettingsMenuItem { label: "外部工具"; selected: root.active-section == 5; activated => { root.active-section = 5; root.about-open = false; } }
                    SettingsMenuItem { label: "日志与诊断"; selected: root.active-section == 6; activated => { root.active-section = 6; root.about-open = false; } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: Theme.panel;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                accessible-role: AccessibleRole.groupbox;
                accessible-label: "设置主要内容";

                if root.about-open : ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    VerticalLayout {
                        min-width: 600px;
                        padding: 20px;
                        spacing: 10px;
                        Text { text: "关于 mySingerServer Rust V2"; height: 28px; vertical-stretch: 0; color: Theme.text; font-size: 18px; font-weight: 700; }
                        Text { text: "Windows x64 媒体重复检测工具 · Slint Royalty-free 2.0"; height: 18px; vertical-stretch: 0; color: Theme.muted; font-size: 12px; }
                        AboutSlint { height: 260px; vertical-stretch: 0; horizontal-stretch: 1; }
                    }
                }

                if !root.about-open && root.active-section == 0 : ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    VerticalLayout {
                        min-width: 600px;
                        padding: 20px;
                        spacing: 12px;
                        Text { text: "常规"; height: 26px; vertical-stretch: 0; color: Theme.text; font-size: 18px; font-weight: 700; }
                        GridLayout {
                            vertical-stretch: 0;
                            spacing: 10px;
                            accessible-role: AccessibleRole.groupbox;
                            accessible-label: "常规表单网格";
                            Row {
                                FormLabel { width: 112px; accessible-name: "PostgreSQL URL 标签"; text: "PostgreSQL URL"; }
                                Rectangle { width: 270px; height: Theme.control-height; vertical-stretch: 0; accessible-role: AccessibleRole.groupbox; accessible-label: "PostgreSQL URL 控件"; LineEdit { width: parent.width; height: parent.height; text <=> root.postgres-url; placeholder-text: "postgresql://user:password@host:5432/database"; accessible-label: "PostgreSQL URL"; } }
                                Text { width: 170px; text: "桌面端唯一中心连接。"; color: Theme.muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
                            }
                            Row {
                                FormLabel { width: 112px; accessible-name: "重连间隔（秒）标签"; text: "重连间隔（秒）"; }
                                Rectangle { width: 270px; height: Theme.control-height; vertical-stretch: 0; accessible-role: AccessibleRole.groupbox; accessible-label: "重连间隔（秒）控件"; SpinBox { width: parent.width; height: parent.height; value <=> root.reconnect-seconds; minimum: 1; maximum: 3600; accessible-label: "重连间隔（秒）"; } }
                                Text { width: 170px; text: "固定秒数后重连同一端点。"; color: Theme.muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
                            }
                            Row {
                                FormLabel { width: 112px; accessible-name: "删除方式标签"; text: "删除方式"; }
                                Rectangle { width: 270px; height: Theme.control-height; vertical-stretch: 0; accessible-role: AccessibleRole.groupbox; accessible-label: "删除方式控件"; ComboBox { width: parent.width; height: parent.height; model: ["回收站（默认）", "永久删除"]; current-index <=> root.delete-mode-index; accessible-label: "删除方式"; } }
                                Text { width: 170px; text: "默认进入回收站。"; color: Theme.muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            height: Theme.control-height;
                            vertical-stretch: 0;
                            border-radius: 6px;
                            background: Theme.warning.with-alpha(0.10);
                            accessible-role: AccessibleRole.groupbox;
                            accessible-label: "可信局域网明文提示";
                            HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "安全提示：节点通信和 PostgreSQL 连接均为明文，只应在可信局域网使用。"; color: Theme.warning; font-size: 12px; overflow: elide; vertical-alignment: center; } }
                        }
                    }
                }

                if !root.about-open && root.active-section == 1 : ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    VerticalLayout {
                        min-width: 600px;
                        padding: 20px;
                        spacing: 10px;
                        Text { text: "相似度算法"; height: 26px; vertical-stretch: 0; color: Theme.text; font-size: 18px; font-weight: 700; }
                        Text { text: "九个阈值会在分析创建时快照；后续修改不改变已有运行。"; height: 18px; vertical-stretch: 0; color: Theme.muted; font-size: 12px; }
                        GridLayout {
                            vertical-stretch: 0;
                            spacing: 12px;
                            Row {
                                VerticalLayout { height: 58px; vertical-stretch: 0; spacing: 4px; FormLabel { text: "PDQ 最低 Quality"; accessible-name: "PDQ 最低 Quality"; } LineEdit { height: Theme.control-height; text <=> root.pdq-quality; accessible-label: "PDQ 最低 Quality"; } }
                                VerticalLayout { height: 58px; vertical-stretch: 0; spacing: 4px; FormLabel { text: "长宽比容差"; accessible-name: "长宽比容差"; } LineEdit { height: Theme.control-height; text <=> root.aspect-tolerance; accessible-label: "长宽比容差"; } }
                                VerticalLayout { height: 58px; vertical-stretch: 0; spacing: 4px; FormLabel { text: "PDQ 最大汉明"; accessible-name: "PDQ 最大汉明"; } LineEdit { height: Theme.control-height; text <=> root.pdq-hamming; accessible-label: "PDQ 最大汉明"; } }
                            }
                            Row {
                                VerticalLayout { height: 58px; vertical-stretch: 0; spacing: 4px; FormLabel { text: "pHash 单块汉明"; accessible-name: "pHash 单块汉明"; } LineEdit { height: Theme.control-height; text <=> root.phash-hamming; accessible-label: "pHash 单块汉明"; } }
                                VerticalLayout { height: 58px; vertical-stretch: 0; spacing: 4px; FormLabel { text: "pHash 最少通过块"; accessible-name: "pHash 最少通过块"; } LineEdit { height: Theme.control-height; text <=> root.phash-parts; accessible-label: "pHash 最少通过块"; } }
                                VerticalLayout { height: 58px; vertical-stretch: 0; spacing: 4px; FormLabel { text: "Sobel 最低相似"; accessible-name: "Sobel 最低相似"; } LineEdit { height: Theme.control-height; text <=> root.sobel-min; accessible-label: "Sobel 最低相似"; } }
                            }
                            Row {
                                VerticalLayout { height: 58px; vertical-stretch: 0; spacing: 4px; FormLabel { text: "视频最少有效帧"; accessible-name: "视频最少有效帧"; } LineEdit { height: Theme.control-height; text <=> root.video-valid; accessible-label: "视频最少有效帧"; } }
                                VerticalLayout { height: 58px; vertical-stretch: 0; spacing: 4px; FormLabel { text: "视频一筛平均"; accessible-name: "视频一筛平均"; } LineEdit { height: Theme.control-height; text <=> root.video-stage1; accessible-label: "视频一筛平均"; } }
                                VerticalLayout { height: 58px; vertical-stretch: 0; spacing: 4px; FormLabel { text: "视频二筛平均"; accessible-name: "视频二筛平均"; } LineEdit { height: Theme.control-height; text <=> root.video-stage2; accessible-label: "视频二筛平均"; } }
                            }
                        }
                    }
                }

                if !root.about-open && root.active-section == 2 : ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    VerticalLayout { min-width: 600px; padding: 20px; spacing: 10px;
                        Text { text: "存储"; height: 26px; vertical-stretch: 0; color: Theme.text; font-size: 18px; font-weight: 700; }
                        Text { text: "以下路径由可执行文件绝对路径推导，只读显示。"; height: 18px; vertical-stretch: 0; color: Theme.muted; font-size: 12px; }
                        ValueRow { label: "数据路径"; value: root.data-path; }
                        ValueRow { label: "配置路径"; value: root.config-path; }
                        ValueRow { label: "日志路径"; value: root.logs-path; }
                        ValueRow { label: "缓存路径"; value: root.cache-path; }
                    }
                }

                if !root.about-open && root.active-section == 3 : ScrollView {
                    horizontal-stretch: 1; vertical-stretch: 1;
                    VerticalLayout { min-width: 600px; padding: 20px; spacing: 12px;
                        Text { text: "节点服务"; height: 26px; vertical-stretch: 0; color: Theme.text; font-size: 18px; font-weight: 700; }
                        DisabledFeatureRow { action-label: "节点服务配置（当前版本未提供）"; reason: "监听、Worker 数量与连接策略尚无可配置字段。"; }
                    }
                }
                if !root.about-open && root.active-section == 4 : ScrollView {
                    horizontal-stretch: 1; vertical-stretch: 1;
                    VerticalLayout { min-width: 600px; padding: 20px; spacing: 12px;
                        Text { text: "扫描与性能"; height: 26px; vertical-stretch: 0; color: Theme.text; font-size: 18px; font-weight: 700; }
                        DisabledFeatureRow { action-label: "扫描性能配置（当前版本未提供）"; reason: "枚举、并发与资源限制当前由既有运行时固定。"; }
                    }
                }
                if !root.about-open && root.active-section == 5 : ScrollView {
                    horizontal-stretch: 1; vertical-stretch: 1;
                    VerticalLayout { min-width: 600px; padding: 20px; spacing: 12px;
                        Text { text: "外部工具"; height: 26px; vertical-stretch: 0; color: Theme.text; font-size: 18px; font-weight: 700; }
                        DisabledFeatureRow { action-label: "外部工具配置（当前版本未提供）"; reason: "FFmpeg 仅从 worker.exe 固定运行目录加载。"; }
                    }
                }

                if !root.about-open && root.active-section == 6 : ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    accessible-role: AccessibleRole.groupbox;
                    accessible-label: "诊断内容滚动区";
                    VerticalLayout {
                        min-width: 600px;
                        padding: 20px;
                        spacing: 10px;
                        Text { text: "日志与诊断"; height: 26px; vertical-stretch: 0; color: Theme.text; font-size: 18px; font-weight: 700; }
                        Rectangle {
                            height: 40px; vertical-stretch: 0; border-radius: 6px; background: Theme.window;
                            accessible-role: AccessibleRole.groupbox; accessible-label: "诊断状态卡";
                            HorizontalLayout { padding-left: 12px; padding-right: 12px;
                                Text { text: "PostgreSQL 状态"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text { text: root.postgres-status; color: root.postgres-color; font-size: 12px; vertical-alignment: center; accessible-label: "PostgreSQL 状态：" + root.postgres-status; }
                            }
                        }
                        Rectangle {
                            height: 218px; vertical-stretch: 0; border-radius: 6px; background: Theme.window;
                            accessible-role: AccessibleRole.groupbox; accessible-label: "诊断路径卡";
                            VerticalLayout { padding: 10px; spacing: 4px;
                                Text { text: "运行路径"; height: 18px; vertical-stretch: 0; color: Theme.text; font-size: 12px; font-weight: 650; }
                                ValueRow { label: "数据路径"; value: root.data-path; }
                                ValueRow { label: "配置路径"; value: root.config-path; }
                                ValueRow { label: "日志路径"; value: root.logs-path; }
                                ValueRow { label: "缓存路径"; value: root.cache-path; }
                            }
                        }
                        ValueRow { label: "最后错误"; value: root.last-error; }
                        Rectangle {
                            height: Theme.control-height; vertical-stretch: 0;
                            accessible-role: AccessibleRole.groupbox; accessible-label: "诊断动作栏";
                            HorizontalLayout { spacing: 8px;
                                ActionButton { horizontal-stretch: 1; label: "日志筛选（当前版本未提供）"; icon: @image-url("../assets/icons/settings.png"); action-enabled: false; }
                                ActionButton { horizontal-stretch: 1; label: "日志导出（当前版本未提供）"; icon: @image-url("../assets/icons/save.png"); action-enabled: false; }
                                ActionButton { horizontal-stretch: 1; label: "日志清空（当前版本未提供）"; icon: @image-url("../assets/icons/settings.png"); action-enabled: false; }
                                ActionButton { horizontal-stretch: 1; label: "环境版本（当前版本未提供）"; icon: @image-url("../assets/icons/info.png"); action-enabled: false; }
                            }
                        }
                    }
                }
            }
        }
    }
}
