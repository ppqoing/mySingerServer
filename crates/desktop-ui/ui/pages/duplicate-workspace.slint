// 四类重复结果共享一个中心窗口；页签只改变类别，不暴露 PostgreSQL 游标。

import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme, UiGroupRow, UiMemberRow } from "../theme.slint";
import { ActionButton } from "../components/action-button.slint";
import { DetailPanel } from "../components/detail-panel.slint";
import { EmptyState } from "../components/empty-state.slint";
import { FilterBar } from "../components/filter-bar.slint";
import { GroupTable } from "../components/group-table.slint";
import { MemberList } from "../components/member-list.slint";
import { SectionHeader } from "../components/section-header.slint";
import { TabStrip } from "../components/tab-strip.slint";

export component DuplicateWorkspace inherits Rectangle {
    in-out property <int> duplicate-tab;
    in property <[UiGroupRow]> groups;
    in property <[UiMemberRow]> members;
    in property <int> result-start-index;
    in property <int> result-total-rows;
    in property <int> member-start-index;
    in property <int> member-total-rows;
    in property <bool> result-loading;
    in property <bool> result-stale;
    in property <image> preview-image;
    in property <string> preview-info;
    in-out property <string> run-id;
    in-out property <string> selected-group-id;
    in-out property <string> cross-selections;
    in property <string> cross-status;
    in property <string> cross-summary;
    callback select-tab(int);
    callback request-group-window(string, int, int, int);
    callback request-member-window(string, string, int, int, int);
    callback save-review(string, string, int);
    callback preview(string, string);
    callback start-cross(string);
    callback poll-cross();
    callback retry-cross();

    // 跨机器结果仍只选择现有 0/1/2 类型，绝不引入第四种 GroupKind。
    property <int> cross-result-kind: 0;
    property <int> query-kind: root.duplicate-tab < 3 ? root.duplicate-tab : root.cross-result-kind;
    property <int> group-visible-count: 100;
    property <int> member-visible-count: 100;
    property <string> result-title: root.duplicate-tab == 0 ? "精确重复结果"
        : root.duplicate-tab == 1 ? "相似图片结果"
        : root.duplicate-tab == 2 ? "相似视频结果"
        : "跨机器重复结果";
    background: transparent;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        TabStrip {
            labels: ["精确重复", "相似图片", "相似视频", "跨机器"];
            active-index: root.duplicate-tab;
            changed(index) => { root.select-tab(index); }
        }

        FilterBar {
            accessible-role: AccessibleRole.groupbox;
            accessible-label: "结果过滤栏";
            if root.duplicate-tab == 3 : ComboBox {
                model: ["精确重复", "相似图片", "相似视频"];
                current-index <=> root.cross-result-kind;
                width: 150px;
                accessible-label: "跨机器结果类型";
            }
            LineEdit {
                text <=> root.run-id;
                placeholder-text: "分析运行 UUID";
                width: 180px;
                accessible-label: "结果运行 ID";
            }
            ActionButton {
                label: "加载结果";
                icon: @image-url("../assets/icons/filter.png");
                tone: 1;
                clicked => { root.request-group-window(root.run-id, root.query-kind, 0, root.group-visible-count); }
            }
        }

        if root.duplicate-tab == 3 : Rectangle {
            height: 96px;
            background: Theme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                LineEdit {
                    text <=> root.cross-selections;
                    placeholder-text: "0:任务UUID, 1:任务UUID";
                    accessible-label: "跨机器任务选择";
                }
                HorizontalLayout {
                    spacing: 8px;
                    ActionButton {
                        label: "创建中心分析";
                        icon: @image-url("../assets/icons/duplicates.png");
                        tone: 1;
                        clicked => { root.start-cross(root.cross-selections); }
                    }
                    ActionButton {
                        label: "推进到下一门禁";
                        icon: @image-url("../assets/icons/sync.png");
                        clicked => { root.poll-cross(); }
                    }
                    ActionButton {
                        label: "重试未解决二筛";
                        icon: @image-url("../assets/icons/retry.png");
                        action-enabled: root.cross-status == "partial";
                        clicked => { root.retry-cross(); }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: root.cross-status + " · " + root.cross-summary;
                        color: Theme.muted;
                        font-size: 10px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // 1440 固定 370 / 伸展 / 300；最小窗口保留三列并让组、成员各自横向滚动。
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            Rectangle {
                width: 370px;
                background: transparent;
                accessible-role: AccessibleRole.groupbox;
                accessible-label: "重复组表";
                VerticalLayout {
                    spacing: 8px;
                    SectionHeader {
                        title: "重复组";
                        subtitle: root.result-stale ? "文件库已变化，结果只读；仍可滚动和预览。" : root.groups.length == 0 ? "仅显示已完成中心分析的当前类别。" : "有限窗口；滚动时按行范围替换。";
                    }
                    GroupTable {
                        vertical-stretch: 1;
                        groups: root.groups;
                        selected-id: root.selected-group-id;
                        start-index: root.result-start-index;
                        total-rows: root.result-total-rows;
                        loading: root.result-loading;
                        stale: root.result-stale;
                        select-group(id) => {
                            root.selected-group-id = id;
                            root.request-member-window(root.run-id, id, root.query-kind, 0, root.member-visible-count);
                        }
                        request-window(start, count) => { root.request-group-window(root.run-id, root.query-kind, start, count); }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                min-width: 50px;
                background: transparent;
                accessible-role: AccessibleRole.groupbox;
                accessible-label: "成员表";
                VerticalLayout {
                    spacing: 8px;
                    SectionHeader {
                        title: "成员列表";
                        subtitle: root.result-stale ? "文件库已变化，结果只读；不能复核或删除。" : root.members.length == 0 ? "选择重复组后显示成员；预览不会自动加载。" : "在线能力、相似分数和当前进程复核投影来自中心窗口。";
                    }
                    MemberList {
                        vertical-stretch: 1;
                        members: root.members;
                        start-index: root.member-start-index;
                        total-rows: root.member-total-rows;
                        loading: root.result-loading;
                        stale: root.result-stale;
                        preview(machine, path) => { root.preview(machine, path); }
                        review-enabled: !root.result-stale && !root.result-loading;
                        review(machine, path, decision) => { root.save-review(machine, path, decision); }
                        request-window(start, count) => {
                            root.request-member-window(root.run-id, root.selected-group-id, root.query-kind, start, count);
                        }
                    }
                }
            }

            DetailPanel {
                width: 300px;
                accessible-role: AccessibleRole.groupbox;
                accessible-label: "详情面板";
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    SectionHeader {
                        title: root.result-title;
                        subtitle: root.duplicate-tab == 1 ? "原图按需解码到内存，不写缩略图。"
                            : root.duplicate-tab == 2 ? "视频只读取既有六帧 3×2 JPG 联系表。"
                            : root.duplicate-tab == 3 ? "跨机器成员来自已完成中心分析的有限窗口。"
                            : "精确重复只展示已加载成员详情。";
                    }
                    if root.preview-image.width > 0 && root.preview-image.height > 0 : Image {
                        source: root.preview-image;
                        image-fit: contain;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                    }
                    if root.preview-image.width <= 0 || root.preview-image.height <= 0 : EmptyState {
                        vertical-stretch: 1;
                        title: "尚未加载预览";
                        detail: "使用成员行的预览动作后，图片或联系表才会显示在这里。";
                        icon: @image-url("../assets/icons/preview.png");
                    }
                    if root.preview-info != "" : Text {
                        text: root.preview-info;
                        color: Theme.muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
