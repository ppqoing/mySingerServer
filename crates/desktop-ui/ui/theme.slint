// 管理端统一浅色主题和跨页面只读行模型。

export struct UiNodeRow {
    index: int,
    name: string,
    address: string,
    status: string,
    status-color: color,
    machine-id: string,
    worker-text: string,
    task-text: string,
    sync-text: string,
    error-text: string,
}

export struct UiTaskRow {
    id: string,
    runtime-id: string,
    owner-kind: string,
    node-index: int,
    machine-id: string,
    title: string,
    stage: string,
    status: string,
    status-color: color,
    progress: int,
    counts: string,
    stale: bool,
}

// 运行任务阶段行保存完整计数和格式化后的实时指标，页面不重复解释单位。
export struct UiRuntimeStageRow {
    stage-id: string,
    name: string,
    state: string,
    state-color: color,
    unit: string,
    progress: int,
    counts: string,
    speed: string,
    elapsed: string,
    eta: string,
    failures: string,
}

// Worker 行使用真实槽位、可选 PID、当前路径和物理磁盘身份。
export struct UiRuntimeWorkerRow {
    slot: int,
    identity: string,
    stage-id: string,
    step: string,
    cache-detail: string,
    path: string,
    disk: string,
    completed: string,
    speed: string,
    phase: string,
    cpu-weight: string,
    decoder-threads: string,
}

// 最近失败行只承载后端已经提供的阶段、路径和错误消息。
export struct UiRuntimeFailureRow {
    stage-id: string,
    path: string,
    message: string,
}

export struct UiGroupRow {
    id: string,
    kind: string,
    md5: string,
    size: string,
    members: int,
    reclaimable: string,
}

export struct UiMemberRow {
    machine-id: string,
    path: string,
    md5: string,
    size: string,
    representative: bool,
    stage1: string,
    phash: string,
    stage2: string,
    metadata: string,
    review: string,
    review-color: color,
    online: bool,
    preview-enabled: bool,
    delete-enabled: bool,
}

// 节点路径选择器只接收节点已经确认存在的目录，不把普通文件伪装成可选根。
export struct UiPathRow {
    path: string,
}

// 每个扫描根都是独立可编辑、可选择和可删除的页面 Item。
export struct UiScanRootRow {
    path: string,
}

export global Theme {
    // 基础表面与边界色供应用壳和各业务页面共享。
    in-out property <color> window: #f8fafc;
    in-out property <color> sidebar: #ffffff;
    in-out property <color> panel: #ffffff;
    in-out property <color> panel-hover: #f1f5f9;
    in-out property <color> border: #e5e7eb;
    // 正文、辅助文字、图标和禁用态形成统一的文字层级。
    in-out property <color> text: #111827;
    in-out property <color> muted: #6b7280;
    in-out property <color> nav-icon: #475569;
    in-out property <color> disabled-text: #94a3b8;
    // 强调与语义色只表达选择、成功、警告和危险状态。
    in-out property <color> accent: #2563eb;
    in-out property <color> accent-soft: #eff6ff;
    in-out property <color> success: #16a34a;
    in-out property <color> warning: #f59e0b;
    in-out property <color> danger: #ef4444;
    in-out property <color> danger-soft: #fef2f2;
    // 固定长度令牌避免页面、表格和详情面板各自漂移。
    in-out property <length> page-padding: 20px;
    in-out property <length> section-gap: 16px;
    in-out property <length> control-height: 34px;
    in-out property <length> form-row-height: 58px;
    in-out property <length> form-label-width: 188px;
    in-out property <length> table-header-height: 34px;
    in-out property <length> table-row-height: 38px;
    in-out property <length> member-row-height: 44px;
    in-out property <length> detail-width: 300px;
}
