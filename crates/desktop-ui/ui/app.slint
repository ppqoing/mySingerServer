// desktop.exe 唯一主窗口；页面只通过属性与回调接触 Rust。

import { Theme, UiGroupRow, UiMemberRow, UiNodeRow, UiTaskRow } from "theme.slint";
import { DeleteDialog } from "components/delete-dialog.slint";
import { AppShell } from "layout/app-shell.slint";
import { OverviewDashboard } from "pages/overview-dashboard.slint";
import { NodesPage } from "pages/nodes-page.slint";
import { ScanPage } from "pages/scan-page.slint";
import { TaskCenterPage } from "pages/task-center-page.slint";
import { DuplicateWorkspace } from "pages/duplicate-workspace.slint";
import { ReviewDeleteWorkspace } from "pages/review-delete-workspace.slint";
import { SettingsWorkspace } from "pages/settings-workspace.slint";

export component MainWindow inherits Window {
    title: "mySingerServer · Media Dedup";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1080px;
    min-height: 700px;
    background: Theme.window;

    in property <[UiNodeRow]> nodes;
    in property <[UiTaskRow]> tasks;
    in property <[UiGroupRow]> groups;
    in property <[UiMemberRow]> members;
    in property <int> online-count;
    in property <int> running-count;
    in property <string> indexed-text: "—";
    in property <string> sync-text: "未同步";
    in property <bool> filtering-enabled;
    in property <string> filtering-reason;
    in property <string> postgres-status;
    in property <color> postgres-color: Theme.warning;
    in property <string> data-path;
    in property <string> logs-path;
    in property <string> cache-path;
    in property <string> config-path;
    in-out property <int> current-page: 0;
    in-out property <int> active-nav: 0;
    in-out property <int> overview-mode: 0;
    in-out property <int> task-mode: 0;
    in-out property <int> task-tab: 0;
    in-out property <int> review-tab: 0;
    in-out property <int> review-filter: 0;
    in-out property <int> delete-filter: 0;
    in-out property <int> settings-section: 0;
    in-out property <string> last-error;

    in-out property <string> new-node-ip: "127.0.0.1";
    in-out property <int> new-node-port: 39091;
    in-out property <string> scan-root: "D:\\Media";
    in-out property <int> scan-node-index: 0;
    in-out property <int> enumerator-index: 0;
    in-out property <bool> force-recalculate: false;
    in-out property <string> analysis-task-ids;
    in-out property <int> analysis-kind-index: 0;

    in-out property <int> result-source-index: 0;
    in-out property <int> result-node-index: 0;
    in-out property <string> result-run-id;
    in-out property <string> selected-group-id;
    in-out property <string> group-next-cursor;
    in-out property <string> member-next-cursor;
    in-out property <image> preview-image;
    in-out property <string> preview-info;
    in-out property <string> cross-selections;
    in-out property <string> cross-status: "未创建";
    in-out property <string> cross-summary;
    in-out property <string> review-path-rule;

    in-out property <bool> delete-dialog-open: false;
    in-out property <int> delete-file-count;
    in-out property <int> delete-node-count;
    in-out property <string> delete-reclaimable;
    in-out property <string> delete-mode: "回收站";
    in-out property <bool> delete-can-execute;
    in-out property <string> delete-warning;

    in-out property <string> postgres-url;
    in-out property <int> reconnect-seconds: 5;
    in-out property <int> delete-mode-index: 0;
    in-out property <string> pdq-quality: "50";
    in-out property <string> aspect-tolerance: "0.10";
    in-out property <string> pdq-hamming: "31";
    in-out property <string> phash-hamming: "10";
    in-out property <string> phash-parts: "8";
    in-out property <string> sobel-min: "0.85";
    in-out property <string> video-valid: "4";
    in-out property <string> video-stage1: "0.80";
    in-out property <string> video-stage2: "0.80";

    callback add-node(string, int);
    callback edit-node(int, string, int);
    callback remove-node(int);
    callback connect-all();
    callback refresh();
    callback sync-node(int);
    callback browse-paths(int, string);
    callback start-scan(int, string, bool, int);
    callback start-local-analysis(int, string, int);
    callback start-cross-analysis(string);
    callback poll-cross-analysis();
    callback retry-cross-analysis();
    callback load-groups(bool, int, string, int, string);
    callback load-members(bool, int, string, string, int, string);
    callback save-review(string, string, int);
    callback quick-review(int, string);
    callback load-preview(string, string);
    callback prepare-delete();
    callback confirm-delete();
    callback cancel-task(int, string);
    callback save-settings();
    callback navigate-to(int);

    navigate-to(index) => {
        if index == 0 {
            root.current-page = 0;
            root.overview-mode = 0;
        } else if index == 1 {
            root.current-page = 0;
            root.overview-mode = 1;
        } else if index == 2 {
            root.current-page = 1;
            root.task-mode = 0;
        } else if index == 3 {
            root.current-page = 1;
            root.task-mode = 1;
        } else if index == 4 {
            if root.current-page < 2 || root.current-page > 5 {
                root.current-page = 2;
            }
        } else if index == 5 {
            root.current-page = 6;
        } else {
            root.current-page = 7;
        }
        root.active-nav = index;
    }

    AppShell {
        active-nav <=> root.active-nav;
        online-count: root.online-count;
        sync-text: root.sync-text;
        postgres-status: root.postgres-status;
        postgres-color: root.postgres-color;
        last-error: root.last-error;
        navigate(index) => { root.navigate-to(index); }
        refresh => { root.refresh(); }
                if root.current-page == 0 && root.overview-mode == 0 : OverviewDashboard {
                    nodes: root.nodes; tasks: root.tasks;
                    online-count: root.online-count; running-count: root.running-count;
                    indexed-text: root.indexed-text; sync-text: root.sync-text;
                }
                if root.current-page == 0 && root.overview-mode == 1 : NodesPage {
                    nodes: root.nodes;
                    new-node-ip <=> root.new-node-ip; new-node-port <=> root.new-node-port;
                    connect-all => { root.connect-all(); }
                    add-node(ip, port) => { root.add-node(ip, port); }
                    edit-node(index, ip, port) => { root.edit-node(index, ip, port); }
                    sync-node(index) => { root.sync-node(index); }
                    remove-node(index) => { root.remove-node(index); }
                }
                if root.current-page == 1 && root.task-mode == 0 : ScanPage {
                    filtering-enabled: root.filtering-enabled; filtering-reason: root.filtering-reason;
                    scan-root <=> root.scan-root; selected-node <=> root.scan-node-index; enumerator-index <=> root.enumerator-index; force-recalculate <=> root.force-recalculate;
                    analysis-task-ids <=> root.analysis-task-ids; analysis-kind-index <=> root.analysis-kind-index;
                    browse(index, path) => { root.browse-paths(index, path); }
                    start-scan(index, path, force, enumerator) => { root.start-scan(index, path, force, enumerator); }
                    start-analysis(index, task-ids, kind) => { root.start-local-analysis(index, task-ids, kind); }
                }
                if root.current-page == 1 && root.task-mode == 1 : TaskCenterPage {
                    tasks: root.tasks;
                    task-tab <=> root.task-tab;
                    cancel-task(index, id) => { root.cancel-task(index, id); }
                }
                if root.current-page >= 2 && root.current-page <= 5 : DuplicateWorkspace {
                    duplicate-tab: root.current-page - 2;
                    groups: root.groups; members: root.members;
                    group-next-cursor: root.group-next-cursor; member-next-cursor: root.member-next-cursor;
                    preview-image: root.preview-image; preview-info: root.preview-info;
                    source-index <=> root.result-source-index; node-index <=> root.result-node-index; run-id <=> root.result-run-id; selected-group-id <=> root.selected-group-id;
                    cross-selections <=> root.cross-selections; cross-status: root.cross-status; cross-summary: root.cross-summary;
                    select-tab(tab) => { root.current-page = 2 + tab; }
                    load-groups(central, node, run, kind, cursor) => { root.load-groups(central, node, run, kind, cursor); }
                    load-members(central, node, run, group, kind, cursor) => { root.load-members(central, node, run, group, kind, cursor); }
                    save-review(machine, path, decision) => { root.save-review(machine, path, decision); }
                    preview(machine, path) => { root.load-preview(machine, path); }
                    start-cross(selections) => { root.start-cross-analysis(selections); }
                    poll-cross => { root.poll-cross-analysis(); }
                    retry-cross => { root.retry-cross-analysis(); }
                }
                if root.current-page == 6 : ReviewDeleteWorkspace {
                    members: root.members; selected-group-id: root.selected-group-id;
                    preview-image: root.preview-image; preview-info: root.preview-info; path-rule <=> root.review-path-rule;
                    review-tab <=> root.review-tab; review-filter <=> root.review-filter; delete-filter <=> root.delete-filter;
                    save-review(machine, path, decision) => { root.save-review(machine, path, decision); }
                    preview(machine, path) => { root.load-preview(machine, path); }
                    quick-review(rule, value) => { root.quick-review(rule, value); }
                    prepare-delete => { root.prepare-delete(); }
                }
                if root.current-page == 7 : SettingsWorkspace {
                    active-section <=> root.settings-section;
                    data-path: root.data-path; logs-path: root.logs-path; cache-path: root.cache-path; config-path: root.config-path;
                    postgres-status: root.postgres-status; postgres-color: root.postgres-color; last-error: root.last-error; postgres-url <=> root.postgres-url;
                    reconnect-seconds <=> root.reconnect-seconds; delete-mode-index <=> root.delete-mode-index;
                    pdq-quality <=> root.pdq-quality; aspect-tolerance <=> root.aspect-tolerance; pdq-hamming <=> root.pdq-hamming;
                    phash-hamming <=> root.phash-hamming; phash-parts <=> root.phash-parts; sobel-min <=> root.sobel-min;
                    video-valid <=> root.video-valid; video-stage1 <=> root.video-stage1; video-stage2 <=> root.video-stage2;
                    save-settings => { root.save-settings(); }
                }
    }

    if root.delete-dialog-open : DeleteDialog {
        file-count: root.delete-file-count; node-count: root.delete-node-count;
        reclaimable: root.delete-reclaimable; mode: root.delete-mode;
        can-execute: root.delete-can-execute; warning: root.delete-warning;
        cancel => { root.delete-dialog-open = false; }
        confirm => { root.confirm-delete(); }
    }
}
