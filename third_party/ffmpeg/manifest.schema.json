{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:my-singer-server:videocore:ffmpeg-manifest:v1",
  "title": "VideoCore FFmpeg SDK supply-chain manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sdk_id",
    "provenance",
    "components",
    "license",
    "evidence_documents",
    "redistributable",
    "blockers",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "sdk_id": {
      "const": "N-125444-g6d72600a30-20260703"
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    },
    "components": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/definitions/component"
      }
    },
    "license": {
      "$ref": "#/definitions/license"
    },
    "evidence_documents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/evidence_document"
      }
    },
    "redistributable": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/blocker"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/file"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "redistributable": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              },
              "source_archive_sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              }
            }
          },
          "license": {
            "properties": {
              "evidence_complete": {
                "const": true
              }
            }
          },
          "blockers": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "definitions": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "version",
        "commit",
        "configure_flags",
        "source_archive_sha256",
        "source_document"
      ],
      "properties": {
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "configure_flags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_archive_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "source_document": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "major"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "major": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "license_file",
        "notice_file",
        "evidence_complete"
      ],
      "properties": {
        "classification": {
          "enum": [
            "lgpl-2.1-or-later",
            "lgpl-3.0-or-later",
            "gpl-2.0-or-later",
            "gpl-3.0-or-later",
            "unknown",
            "nonfree"
          ]
        },
        "license_file": {
          "type": "string",
          "minLength": 1
        },
        "notice_file": {
          "type": "string",
          "minLength": 1
        },
        "evidence_complete": {
          "type": "boolean"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "source",
            "license",
            "notice"
          ]
        },
        "path": {
          "enum": [
            "SOURCE.md",
            "LICENSE.txt",
            "NOTICE.md"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(include|lib|bin)/.+"
        },
        "kind": {
          "enum": [
            "header",
            "msvc-import-lib",
            "gnu-import-lib",
            "runtime-dll"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    }
  }
}
